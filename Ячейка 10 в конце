def fm(x, d=2):
    try:
        if x is None or (isinstance(x, float) and np.isnan(x)):
            return "n/a"
        return f"{x:.{d}f}"
    except Exception:
        return str(x)


def ci(t):
    return "n/a" if (t is None or t[0] is None) else f"[{t[0]}; {t[1]}]"


def V(m, k, d=2):
    return fm(m.get(k), d) if m else "n/a"


def df_to_md(d):
    d = d.reset_index()
    cols = [str(c) for c in d.columns]
    lines = ["| " + " | ".join(cols) + " |", "|" + "---|" * len(cols)]
    for _, r in d.iterrows():
        lines.append("| " + " | ".join(str(v) for v in r.values) + " |")
    return "\n".join(lines)


